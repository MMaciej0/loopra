# Copy to .env and fill in the empty values.
# Inside Docker, compose overrides DATABASE_URL, REDIS_URL, PORT and TRUSTED_PROXIES for the api container.

# API
DATABASE_URL=postgres://loopra:loopra@localhost:5433/loopra
REDIS_URL=redis://localhost:6380
PORT=8080
NODE_ENV=development
JWT_ACCESS_SECRET=                # at least 32 characters
APP_URL=http://localhost:3000

# Email (Resend)
RESEND_API_KEY=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

# S3-compatible storage (GPX files)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Web
API_URL=http://api:8080
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_MAPTILER_KEY=
