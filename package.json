{
  "name": "loopra",
  "private": true,
  "scripts": {
    "api:dev": "pnpm --filter api dev",
    "api:build": "pnpm --filter api build",
    "api:test": "pnpm --filter api test",
    "api:db:generate": "pnpm --filter api db:generate",
    "api:db:migrate": "pnpm --filter api db:migrate",
    "api:db:studio": "pnpm --filter api db:studio",
    "web:dev": "pnpm --filter web exec next dev --hostname 0.0.0.0",
    "web:build": "pnpm --filter web build",
    "web:lint": "pnpm --filter web lint",
    "web:format": "pnpm --filter web format",
    "web:format:check": "pnpm --filter web format:check",
    "web:start": "pnpm --filter web exec next start --hostname 0.0.0.0",
    "web:typecheck": "pnpm --filter web typecheck",
    "web:ui:add": "pnpm dlx shadcn@latest add -c apps/web",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format && prettier --write \"*.{json,md,yml,yaml}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\"",
    "format:check": "pnpm -r format:check && prettier --check \"*.{json,md,yml,yaml}\" \"docs/**/*.md\" \".github/**/*.{yml,yaml}\"",
    "typecheck": "pnpm -r typecheck"
  },
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
