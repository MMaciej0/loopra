    "db:seed": "tsx src/db/seed.ts",
    "db:seed:staging": "tsx src/db/runStagingSeed.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
