# Dummy values for the test suite. Nothing here is real and nothing here is secret.
# The suite never reaches an external service: email, OAuth and S3 are mocked or
# unreachable, so only the shape of these values matters to the config schema.
#
# Loaded by vitest without overriding variables already set, so running the suite
# inside the api container keeps using the values docker compose injects.
#
# Points at docker-compose-test.yml, not the dev stack.
#
# DO NOT put real credentials here, even temporarily. Unlike every other .env
# file in this repo, this one is TRACKED (via a .gitignore negation), so a real
# key pasted here to debug one test gets committed by the next `git add -A`.
# To experiment locally without risking that:
#   git update-index --skip-worktree apps/api/.env.test

DATABASE_URL=postgres://loopra:loopra@localhost:5434/loopra
REDIS_URL=redis://localhost:6381

PORT=8080
NODE_ENV=test

JWT_ACCESS_SECRET=test-secret-not-a-real-key-0000000000

APP_URL=http://localhost:3000
RESEND_API_KEY=re_dummy_not_a_real_key

GOOGLE_CLIENT_ID=dummy-google-client-id
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8080/auth/google/callback

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=loopra-test
S3_ACCESS_KEY_ID=dummy-access-key-id
S3_SECRET_ACCESS_KEY=dummy-secret-access-key
S3_REGION=auto
