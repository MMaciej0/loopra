{
  "name": "@loopra/domain",
  "version": "1.0.0",
  "description": "Shared Loopra domain vocabulary: enums, bounds, errors, response DTOs",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "default": "./dist/schemas/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "5.9.3",
    "zod": "^4.3.6"
  },
  "dependencies": {
    "typebox": "^1.3.30"
  },
  "peerDependencies": {
    "zod": "^4.3.6"
  }
}
